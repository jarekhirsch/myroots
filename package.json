{
  "name": "myroots-app",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "MyRoots — genealogy app for desktop, mobile and the web",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "i18n": "node scripts/build-app-strings.mjs && node scripts/po2json.mjs",
    "dev": "vite",
    "build:viewer": "vite build --mode viewer && node scripts/finalize-viewer.mjs",
    "build:app": "vite build",
    "build": "npm run wasm && npm run build:viewer && npm run build:app",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "binaryen": "^132.0.0",
    "jszip": "^3.10.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@lucide/svelte": "^1.77.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vladmandic/face-api": "^1.7.15",
    "d3": "^7.9.2",
    "dompurify": "^3.5.0",
    "family-chart": "^0.9.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.19.0"
  }
}
